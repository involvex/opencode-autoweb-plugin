{
	"name": "@involvex/opencode-autoweb-plugin",
	"version": "0.2.0",
	"description": "An awesome OpenCode plugin",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"plugin"
	],
	"license": "MIT",
	"author": "involvex <39644169+involvex@users.noreply.github.com>",
	"type": "module",
	"main": "src/index.ts",
	"files": [
		"src"
	],
	"scripts": {
		"check": "bun run format && bun run lint:fix && bun run typecheck",
		"dev": "bun run dev.ts",
		"format": "prettier . --write",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"setup": "bun run setup.ts",
		"typecheck": "tsc --noEmit",
		"unregister": "bun run unregister.ts"
	},
	"dependencies": {
		"@opencode/plugin": "^2.0.22",
		"@opencode/sdk": "^2.0.22"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.1.2",
		"eslint": "^10.8.0",
		"prettier": "^3.9.9",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.65.0"
	}
}
